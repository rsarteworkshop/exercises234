          <transition xmi:id="_rTmNAJ_QEfGhD7BLCbP21w" name="ewClosed" redefinedTransition="_ViODoJ-JEfGhD7BLCbP21w">
            <effect xmi:type="uml:OpaqueBehavior" xmi:id="_rTnbIZ_QEfGhD7BLCbP21w" name="Effect">
              <language><![CDATA[C++]]></language>
              <body><![CDATA[controllerPort.closeEWLane().send();

]]></body>
            </effect>
          </transition>
          <transition xmi:id="_tV9tYJ_QEfGhD7BLCbP21w" name="ewOpened" redefinedTransition="_wEIcEJ-JEfGhD7BLCbP21w">
            <effect xmi:type="uml:OpaqueBehavior" xmi:id="_tV-7gJ_QEfGhD7BLCbP21w" name="Effect">
              <language><![CDATA[C++]]></language>
              <body><![CDATA[controllerPort.openEWLane().send();]]></body>
            </effect>
          </transition>
          <transition xmi:id="_nxCS8J_VEfGhD7BLCbP21w" name="initialized" redefinedTransition="_3fHxsZ0-EfGhD7BLCbP21w">
            <effect xmi:type="uml:OpaqueBehavior" xmi:id="_nxDhEJ_VEfGhD7BLCbP21w" name="Effect">
              <language><![CDATA[C++]]></language>
              <body><![CDATA[nsLaneCount = *rtdata;

RTActorId id = frame.incarnateCustom(controller,
	RTActorFactory([this](RTController * c, RTActorRef * a, int index) {
		return new ControllerWithWarnings_Actor(ControllerThread, a, nsLaneCount);
	})
);
if (!id.isValid()) {
	context()->perror(context()->strerror());
}

id = frame.incarnateCustom(webUI,
	RTActorFactory([this](RTController * c, RTActorRef * a, int index) {
		return new WebUI_Actor(WebUIThread, a, cmdLineArgs.port, cmdLineArgs.remotePort, cmdLineArgs.remoteHost);
	})
);
if (!id.isValid()) {
	context()->perror(context()->strerror());
}

incarnateNorthSouth();

]]></body>
            </effect>
          </transition>
        </region>
      </ownedBehavior>
    </packagedElement>
