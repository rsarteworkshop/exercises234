      <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_sXzYoKIYEfGhD7BLCbP21w" name="WebUI" specification="_VU7S4KIYEfGhD7BLCbP21w">
        <language><![CDATA[C++]]></language>
        <body><![CDATA[config.port = (port != 0) ? port : 7001; // Default port
config.remotePort = (remotePort != 0) ? remotePort : 7002; // Default remote port

if (!remoteHost.empty())
	config.remoteHost = remoteHost; // Default remote host is "127.0.0.1"

//config.logToStdOut = false;       
Log::out << "Web UI TCP Server started!" << std::endl;
Log::out << "port=" << config.port << " remotePort=" << config.remotePort << " remoteHost=" << config.remoteHost << "!" << std::endl;]]></body>
      </ownedBehavior>
