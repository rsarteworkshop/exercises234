          <subvertex xmi:type="uml:State" xmi:id="_TIKcAJ-JEfGhD7BLCbP21w" name="EWLanesClosed"/>
          <transition xmi:id="_3fHxsZ0-EfGhD7BLCbP21w" name="initialized" source="_ZLwakJ7jEfGhD7BLCbP21w" target="_3fHxsJ0-EfGhD7BLCbP21w">
            <eAnnotations xmi:id="_3fIYwJ0-EfGhD7BLCbP21w" source="uml2.alias">
              <details xmi:id="_3fIYwZ0-EfGhD7BLCbP21w" key="Initial"/>
            </eAnnotations>
            <effect xmi:type="uml:OpaqueBehavior" xmi:id="_K2ZO8J1sEfGhD7BLCbP21w" name="Effect">
              <language><![CDATA[C++]]></language>
              <body><![CDATA[nsLaneCount = *rtdata;

RTActorId id = frame.incarnateCustom(controller,
	RTActorFactory([this](RTController * c, RTActorRef * a, int index) {
		return new Controller_Actor(c, a, nsLaneCount);
	})
);
if (!id.isValid()) {
	context()->perror(context()->strerror());
}

incarnateNorthSouth();

]]></body>
            </effect>
            <trigger xmi:id="_wpURMJ7jEfGhD7BLCbP21w" name="" event="_eerXoJ7hEfGhD7BLCbP21w" port="_dF3VIJ7iEfGhD7BLCbP21w"/>
            <trigger xmi:id="_krsiAKHrEfGhD7BLCbP21w" name="" event="_eerXoJ7hEfGhD7BLCbP21w" port="_4ZWN0KHqEfGhD7BLCbP21w"/>
          </transition>
          <transition xmi:id="_btdiUJ7jEfGhD7BLCbP21w" name="Initial" source="_3fHKoJ0-EfGhD7BLCbP21w" target="_ZLwakJ7jEfGhD7BLCbP21w">
            <eAnnotations xmi:id="_bteJYJ7jEfGhD7BLCbP21w" source="uml2.alias">
              <details xmi:id="_bteJYZ7jEfGhD7BLCbP21w" key="Initial"/>
            </eAnnotations>
            <effect xmi:type="uml:OpaqueBehavior" xmi:id="_C-XeAKHmEfGhD7BLCbP21w" name="Effect">
              <language><![CDATA[C++]]></language>
              <body><![CDATA[cmdLineArgs = parseCommandLine();
if (cmdLineArgs.nsLaneCount > 0 && cmdLineArgs.nsLaneCount <= 2)
	initializeSystemInternal_send.setNSLaneCount(cmdLineArgs.nsLaneCount).send();
//Log::out << cmdLineArgs.nsLaneCount << Log::endl;]]></body>
            </effect>
          </transition>
          <transition xmi:id="_ViODoJ-JEfGhD7BLCbP21w" name="ewClosed" source="_3fHxsJ0-EfGhD7BLCbP21w" target="_TIKcAJ-JEfGhD7BLCbP21w">
            <effect xmi:type="uml:OpaqueBehavior" xmi:id="_PiJiIJ-KEfGhD7BLCbP21w" name="Effect">
              <language><![CDATA[C++]]></language>
              <body><![CDATA[controllerPort.closeEWLane().send();

if (!frame.destroy(north)) {
	context()->perror(context()->strerror());
}
if (!frame.destroy(south)) {
	context()->perror(context()->strerror());
}
]]></body>
            </effect>
            <trigger xmi:id="_squ3UJ-JEfGhD7BLCbP21w" name="" event="_NjCmkJ-JEfGhD7BLCbP21w" port="_nJ_LkJ-JEfGhD7BLCbP21w"/>
          </transition>
          <transition xmi:id="_wEIcEJ-JEfGhD7BLCbP21w" name="ewOpened" source="_TIKcAJ-JEfGhD7BLCbP21w" target="_3fHxsJ0-EfGhD7BLCbP21w">
            <effect xmi:type="uml:OpaqueBehavior" xmi:id="_B87poJ-KEfGhD7BLCbP21w" name="Effect">
              <language><![CDATA[C++]]></language>
              <body><![CDATA[controllerPort.openEWLane().invoke();

incarnateNorthSouth();]]></body>
            </effect>
            <trigger xmi:id="_xjKl4J-JEfGhD7BLCbP21w" name="" event="_jPMxAJ-JEfGhD7BLCbP21w" port="_nJ_LkJ-JEfGhD7BLCbP21w"/>
          </transition>
        </region>
      </ownedBehavior>
      <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_701qAJ-JEfGhD7BLCbP21w" name="incarnateNorthSouth" specification="_4GhlMJ-JEfGhD7BLCbP21w">
        <language><![CDATA[C++]]></language>
        <body><![CDATA[RTActorId id;
for (int i = 0; i < nsLaneCount; i++) {
	id = frame.incarnate(north);
	if (!id.isValid()) {
		context()->perror(context()->strerror());
	}
	
	id = frame.incarnate(south); 
	if (!id.isValid()) {
		context()->perror(context()->strerror());
	}
}]]></body>
      </ownedBehavior>
      <ownedOperation xmi:id="_4GhlMJ-JEfGhD7BLCbP21w" name="incarnateNorthSouth" visibility="protected" method="_701qAJ-JEfGhD7BLCbP21w"/>
