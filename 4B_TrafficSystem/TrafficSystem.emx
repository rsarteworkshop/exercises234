            <entry xmi:type="uml:OpaqueBehavior" xmi:id="_FbqC8KA9EfGhD7BLCbP21w" name="Entry">
              <language><![CDATA[C++]]></language>
              <body><![CDATA[blinkTimerRequest = blinkTimer.informEvery(RTTimespec(2,0));]]></body>
            </entry>
            <exit xmi:type="uml:OpaqueBehavior" xmi:id="_MLdi0KA9EfGhD7BLCbP21w" name="Exit">
              <language><![CDATA[C++]]></language>
              <body><![CDATA[if (blinkTimerRequest.isValid())
	blinkTimer.cancelTimer(blinkTimerRequest);]]></body>
            </exit>
