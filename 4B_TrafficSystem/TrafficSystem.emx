  <CppPropertySets:GeneralArtifactProperties xmi:id="__FdIMKHkEfGhD7BLCbP21w" base_Artifact="_xb_B0KHkEfGhD7BLCbP21w">
    <Header xmi:id="__FdvQKHkEfGhD7BLCbP21w">
      <body><![CDATA[CmdLineArgs parseCommandLine();]]></body>
    </Header>
    <Implementation xmi:id="__FdvQaHkEfGhD7BLCbP21w">
      <body><![CDATA[#include <string>

CmdLineArgs parseCommandLine() {
	CmdLineArgs cmdLineArgs;

	int ac = RTMain::argCount();
	const char * const * av = RTMain::argStrings();
	std::string arg_remotePort = "-remotePort=",
			arg_remoteHost = "-remoteHost=",
			arg_port = "-port=",
			arg_nsLaneCount = "-nsLaneCount=";

	while(--ac > 0) {
		std::string arg = *++av;
		if (arg.compare(0, arg_nsLaneCount.size(), arg_nsLaneCount) == 0 )
			cmdLineArgs.nsLaneCount = RTMemoryUtil::atoi(*av + arg_nsLaneCount.size());
		else if (arg.compare(0, arg_remotePort.size(), arg_remotePort) == 0 )
			cmdLineArgs.remotePort = RTMemoryUtil::atoi(*av + arg_remotePort.size());
		else if (arg.compare(0, arg_remoteHost.size(), arg_remoteHost) == 0 )
			cmdLineArgs.remoteHost = arg.substr(arg_remoteHost.size());
		else if (arg.compare(0, arg_port.size(), arg_port) == 0 )
			cmdLineArgs.port = RTMemoryUtil::atoi(*av + arg_port.size());
	}

    return cmdLineArgs;
}]]></body>
    </Implementation>
