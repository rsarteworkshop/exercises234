        <region xmi:id="_uxkXQZ00EfGhD7BLCbP21w" name="Region1">
          <subvertex xmi:type="uml:Pseudostate" xmi:id="_uxkXQp00EfGhD7BLCbP21w"/>
          <subvertex xmi:type="uml:State" xmi:id="_uxk-UJ00EfGhD7BLCbP21w" name="NSGreen">
            <entry xmi:type="uml:OpaqueBehavior" xmi:id="_mqdLkJ1HEfGhD7BLCbP21w" name="Entry">
              <language><![CDATA[C++]]></language>
              <body><![CDATA[timing.informIn(RTTimespec(10,0));
north.green().sendAt(0);
south.green().sendAt(0);
east.red().send();
west.red().send();]]></body>
            </entry>
          </subvertex>
          <subvertex xmi:type="uml:State" xmi:id="_SUVPsJ02EfGhD7BLCbP21w" name="NSYellow">
            <entry xmi:type="uml:OpaqueBehavior" xmi:id="_1wCDkJ1HEfGhD7BLCbP21w" name="Entry">
              <language><![CDATA[C++]]></language>
              <body><![CDATA[timing.informIn(RTTimespec(2,0));
north.yellow().sendAt(0);
south.yellow().sendAt(0);
east.red().send();
west.red().send();]]></body>
            </entry>
          </subvertex>
          <subvertex xmi:type="uml:State" xmi:id="_TdiTcJ02EfGhD7BLCbP21w" name="EWGreen">
            <entry xmi:type="uml:OpaqueBehavior" xmi:id="_6jxfYJ1HEfGhD7BLCbP21w" name="Entry">
              <language><![CDATA[C++]]></language>
              <body><![CDATA[timing.informIn(RTTimespec(10,0));
north.red().sendAt(0);
south.red().sendAt(0);
east.green().send();
west.green().send();]]></body>
            </entry>
          </subvertex>
          <subvertex xmi:type="uml:State" xmi:id="_UsNGAJ02EfGhD7BLCbP21w" name="EWYellow">
