              <language><![CDATA[C++]]></language>
              <body><![CDATA[timing.informIn(RTTimespec(2,0));
north.red().sendAt(0);
south.red().sendAt(0);
east.yellow().send();
west.yellow().send();]]></body>
            </entry>
          </subvertex>
